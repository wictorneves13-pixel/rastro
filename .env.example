# ───────── Obrigatórias ─────────
# Postgres. Se você conectou o Neon pelo painel da Vercel (Storage), isso já vem preenchido.
DATABASE_URL=

# Senha para entrar no painel e chave usada para assinar a sessão (invente textos longos)
ADMIN_PASSWORD=
SESSION_SECRET=

# Chave que protege os webhooks (Stevo e GHL). Invente um texto longo, sem espaços.
WEBHOOK_SECRET=

# ───────── Meta (envio de conversões) ─────────
# ID do Pixel / Conjunto de dados e token da API de Conversões
META_PIXEL_ID=
META_CAPI_TOKEN=
# Opcional: código da aba "Testar eventos" do Gerenciador de Eventos (use só enquanto testa)
META_TEST_EVENT_CODE=
# Opcional: ID da conta do WhatsApp Business (WABA). Necessário para enviar com ctwa_clid
META_WABA_ID=

# ───────── Meta Ads (gasto por anúncio no painel) ─────────
# Token com permissão ads_read e ID da conta de anúncios (pode ser com ou sem "act_")
META_ADS_TOKEN=
META_AD_ACCOUNT_ID=

# ───────── GoHighLevel ─────────
# Private Integration token (Configurações > Integrações privadas) e ID da subconta (Location ID)
GHL_TOKEN=
GHL_LOCATION_ID=
# Opcional: IDs dos campos personalizados do GHL que recebem a origem. JSON em uma linha.
# Chaves aceitas: origem, canal, campanha, conjunto, anuncio, ad_id, ctwa_clid, pagina
# Exemplo: {"origem":"AbC123","campanha":"DeF456","anuncio":"GhI789"}
GHL_CUSTOM_FIELDS=

# ───────── Ajustes ─────────
DEFAULT_COUNTRY_CODE=55
CURRENCY=BRL
TZ_NAME=America/Sao_Paulo
# Opcional: restringe quais sites podem enviar dados ao script. Ex: https://meusite.com.br,https://www.meusite.com.br
ALLOWED_ORIGINS=
