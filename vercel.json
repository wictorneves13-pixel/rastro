{
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/l/:slug", "destination": "/api/r?slug=:slug" }
  ],
  "headers": [
    {
      "source": "/t.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ],
  "functions": {
    "api/*.js": { "maxDuration": 30 }
  }
}
